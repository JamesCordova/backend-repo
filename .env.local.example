# Variables para correr backend-repo SIN Docker (Postgres nativo en
# localhost, archivos en el filesystem local -- ver README, seccion "Correr
# sin Docker"). Distinto de .env.example (ese es para docker-compose.yml:
# usa DB_PASSWORD, que arma el compose; este .env lo lee la app directo via
# pydantic-settings, con los NOMBRES REALES de Settings).
#
# De hecho, TODOS estos valores son ya los defaults hardcodeados en
# infrastructure/config.py -- este archivo existe para que quede explicito y
# documentado, no porque haga falta para que la app arranque.

ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://app:devpassword@localhost:5432/axial
JWT_SECRET=changeme
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173
# "local": guarda los archivos subidos/procesados bajo LOCAL_STORAGE_DIR,
# sin ningun servicio externo (ni Docker, ni un binario de MinIO aparte --
# los binarios community de MinIO dejaron de publicarse para descarga
# directa a fines de 2025). Relativo al directorio desde donde corras
# `uvicorn` (la raiz de este repo si seguis el README tal cual).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/objects
