ENVIRONMENT=dev
DB_PASSWORD=devpassword
JWT_SECRET=changeme
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173
# Sin variables de MinIO: storage_backend="local" (default, ver
# infrastructure/config.py) guarda los archivos en un volumen Docker propio
# (objects_data, ver docker-compose.yml), no en un servicio S3 aparte. Si
# preferis un MinIO/S3 real, agregalo vos a docker-compose.yml y descomenta:
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=axial-studies
# Cuantos estudios se procesan en simultaneo como maximo (ProcessPoolExecutor,
# ver src/infrastructure/queue/in_process_task_queue.py). Comentado (no
# declarado) deja que Python use os.process_cpu_count() -- un valor vacio
# aca rompe la validacion de pydantic-settings para un int, no lo dejes en
# blanco. Descomenta y bajalo (ej. 2) si esta maquina tiene pocos
# nucleos/RAM y notas que procesar un estudio grande deja el resto de la
# API lenta.
# PROCESSING_WORKERS=2
